{
  "name": "ngg-nexus-language-tool",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "NGG · NEXUS 2026 · איזו שפה אתם דוברים? — static mobile site",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test logic/scoring.test.mjs && vitest run",
    "test:e2e": "npm run build && npm run build:renamed && playwright test",
    "build:renamed": "node e2e/make-renamed-content.mjs && CONTENT_FILE=e2e/.tmp/content-renamed.json OUT_DIR=dist-renamed vite build"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@fontsource-variable/heebo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
